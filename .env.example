# ─────────────────────────────────────────────────────────────────────────────
# Claude Trader configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude (via your Max/Pro subscription — NOT the Anthropic API) ────────────
# Generate this once by running:  npm run setup-token   (or: claude setup-token)
# It mints a long-lived OAuth token tied to your Claude subscription so the
# Agent SDK runs against your Max plan instead of pay-as-you-go API billing.
CLAUDE_CODE_OAUTH_TOKEN=

# IMPORTANT: Do NOT set ANTHROPIC_API_KEY. If it is set, the SDK uses the API
# (and bills your API account) instead of your subscription.

# Which Claude model the trading agent should use.
CLAUDE_MODEL=claude-opus-4-8

# ── Market data (decisions) ───────────────────────────────────────────────────
# The bot reads prices through a provider abstraction. By default it uses
# Alpaca's free real-time IEX feed (real-time, but thin coverage). Add a free
# Finnhub key (https://finnhub.io — free tier) for broader real-time US quotes;
# when set, Finnhub becomes the primary quote source with Alpaca as fallback.
FINNHUB_API_KEY=

# ── Alpaca (brokerage) ────────────────────────────────────────────────────────
# Create keys at https://alpaca.markets (use PAPER keys to start — fake money).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Trading mode: "paper" (simulated, safe default) or "live" (REAL money).
# Live trading additionally requires ALLOW_LIVE_TRADING=true below.
TRADING_MODE=paper

# Hard safety switch. Must be exactly "true" to permit live (real-money) orders.
ALLOW_LIVE_TRADING=false

# Per-trade size limit as a % of CURRENT portfolio value. Every BUY is capped at
# this share of your equity (e.g. 5% of a $2,000 account = $100/trade), enforced
# server-side before any order is sent. It scales as your portfolio grows. Sells
# are not capped (reducing exposure is always allowed).
MAX_TRADE_PCT=5

# Daily-loss circuit breaker: when the account is down this % vs yesterday's
# close, all NEW BUYS are blocked for the rest of the day (sells still allowed).
DAILY_LOSS_LIMIT_PCT=3

# Day-trade guard: block selling a position that was bought the same day. This
# keeps a small account clear of Pattern-Day-Trader limits (margin accounts) and
# good-faith violations (cash accounts). Strongly recommended under $25k.
AVOID_DAY_TRADES=true

# No-leverage mode: only invest settled cash, never the account's margin buying
# power (e.g. a $2k account won't deploy more than $2k even though Alpaca offers
# 4x). Recommended to faithfully simulate a cash account.
NO_LEVERAGE=true

# Where the SQLite database lives (run history, agent journal, watchlist).
# Defaults to ./data inside the server workspace.
# DATA_DIR=./data

# ── Daily autopilot (scheduler) ───────────────────────────────────────────────
# Master switch for running the agent automatically each trading day.
SCHEDULE_ENABLED=true

# Run times in US MARKET TIME (America/New_York). Weekends & holidays are skipped
# automatically. Set any to "off" to disable that slot.
#   MORNING_TIME  — assess + plan the day  (default 10:00, 15min after open so the
#                   free 15-min-delayed data is meaningful)
#   MIDDAY_TIME   — midday check-in        (default 12:30)
#   PRECLOSE_TIME — position into the close (default 15:45)
#   EOD_TIME      — end-of-day summary, REVIEW ONLY / no trades (default 16:15)
MORNING_TIME=10:00
MIDDAY_TIME=12:30
PRECLOSE_TIME=15:45
EOD_TIME=16:15

# ── Discord notifications ─────────────────────────────────────────────────────
# Get pinged when the bot places an order, gets blocked by a risk guard, hits an
# error, or finishes its end-of-day summary. Create a webhook in your Discord
# channel: Channel → Edit → Integrations → Webhooks → New Webhook → Copy URL.
# Leave blank to disable notifications entirely.
DISCORD_WEBHOOK_URL=

# Set to false to suppress the "run started" ping (keeps only the meaningful
# alerts: orders, blocks, errors, summaries).
NOTIFY_RUN_START=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
