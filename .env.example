# ─────────────────────────────────────────────────────────────────────────────
# Claude Trader configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude (via your Max/Pro subscription — NOT the Anthropic API) ────────────
# Generate this once by running:  npm run setup-token   (or: claude setup-token)
# It mints a long-lived OAuth token tied to your Claude subscription so the
# Agent SDK runs against your Max plan instead of pay-as-you-go API billing.
CLAUDE_CODE_OAUTH_TOKEN=

# IMPORTANT: Do NOT set ANTHROPIC_API_KEY. If it is set, the SDK uses the API
# (and bills your API account) instead of your subscription.

# Which Claude model the trading agent should use.
CLAUDE_MODEL=claude-opus-4-8

# ── Alpaca (brokerage) ────────────────────────────────────────────────────────
# Create keys at https://alpaca.markets (use PAPER keys to start — fake money).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Trading mode: "paper" (simulated, safe default) or "live" (REAL money).
# Live trading additionally requires ALLOW_LIVE_TRADING=true below.
TRADING_MODE=paper

# Hard safety switch. Must be exactly "true" to permit live (real-money) orders.
ALLOW_LIVE_TRADING=false

# Per-order notional ceiling in USD. The agent can never place a single order
# larger than this, regardless of what it decides. Protects against runaways.
MAX_ORDER_NOTIONAL_USD=1000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
